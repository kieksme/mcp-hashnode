{
  "inputs": [
    { "type": "promptString", "id": "hashnode_token", "description": "Hashnode Personal Access Token", "password": true }
  ],
  "servers": {
    "hashnode": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@kieksme/hashnode-mcp"],
      "env": { "HASHNODE_TOKEN": "${input:hashnode_token}" }
    }
  }
}
